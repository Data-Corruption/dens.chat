*.sh text eol=lf
*.go text eol=lf
internal/build/notices.txt text eol=lf
# The page's list of emoji, which scripts/emoji.sh --check compares byte for byte.
internal/ui/assets/emoji.json text eol=lf
# The codes the page's reader is tested on, which TestPageCodes compares
# byte for byte.
internal/denclient/testdata/qrcodes.json text eol=lf
*.syso binary
# A release's signed checksums, which tests check byte for byte, and
# Sigstore's trusted root as its TUF repository served it.
internal/platform/release/testdata/** -text
internal/platform/release/trusted_root.json -text
# Generated files, which their scripts write: GitHub folds them in a pull
# request's diff. The media module's translation stays out of diffs and
# git grep -I too.
internal/media/ffmpeg/module/** linguist-generated
internal/media/ffmpeg/module/module.go -diff
internal/media/ffmpeg/module/module.dat -diff
internal/denproto/emojilist.go linguist-generated
internal/ui/assets/emoji.json linguist-generated
internal/ui/assets/wasm/rnnoise.wasm linguist-generated
internal/build/notices.txt linguist-generated
cmd/*.syso linguist-generated
